#!/usr/bin/env python3
import sys
from pathlib import Path

datadir = Path("@DATADIR@")
if datadir.is_dir():
    sys.path.insert(0, str(datadir))
else:
    sys.path.insert(0, str(Path(__file__).resolve().parent))


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "daemon":
        import os

        os.environ.setdefault("PULSE_SINK", "ntg_send")
        from ntg_console.daemon import main as daemon_main
        return daemon_main()
    if len(sys.argv) > 1 and sys.argv[1] == "doctor":
        from ntg_console.doctor import main as doctor_main
        return doctor_main()
    from ntg_console.app import main as app_main
    return app_main()


if __name__ == "__main__":
    raise SystemExit(main())
